# Example Environment Variables File
# Do NOT place actual secrets here. Use this as a reference to create your local `.env` file.

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hiring_db
REDIS_URL=redis://localhost:6379/0

# Required External Services Auth
GROQ_API_KEY=
GITHUB_TOKEN=

# Global Auth Configurations
SECRET_KEY=

# .\venv\Scripts\Activate
# uvicorn app.main:app --reload
